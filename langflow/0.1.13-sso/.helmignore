# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# ── 0.1.13 additions ─────────────────────────────────────────────────────────
# Never ship these inside the chart archive:
*.tgz
*.tar.gz
# Docs live in the repo, not in the package PCAI imports.
README.md
